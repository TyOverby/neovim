{
  "manifest_version": 3,
  "name": "Neovim Textarea",
  "version": "0.1.0",
  "description": "Edit any <textarea> in Neovim (WebAssembly): press Ctrl+Shift+. in a textarea, edit, :wq to write the text back.",
  "minimum_chrome_version": "137",

  "background": { "service_worker": "background.js" },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["trigger.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],

  "permissions": ["offscreen", "scripting", "clipboardRead", "clipboardWrite"],
  "host_permissions": ["<all_urls>"],

  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
