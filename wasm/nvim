#!/usr/bin/env bash
# wasm/nvim - launcher for the WebAssembly build of Neovim.
#
# Runs nvim.js under Node with JSPI (WebAssembly.Suspending) enabled, which the
# event loop needs to suspend the main-thread UI client. JSPI is on by default in
# Node 24+, but Node 22/23 gate it behind --experimental-wasm-jspi. The engine
# worker inherits process.execArgv, so the flag only needs to go here.
#
# Usage:  wasm/nvim [nvim args]      e.g.  wasm/nvim /tmp/foo.txt
# Override the interpreter with $NODE.
#
# Until the wasm build is more complete, this defaults to a clean session: no
# user config (-u NONE) and no shada (-i NONE). Override the defaults with
# $NVIM_WASM_DEFAULTS (set it empty to pass nothing).
set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
NODE="${NODE:-node}"

major="$("$NODE" -e 'process.stdout.write(String(process.versions.node.split(".")[0]))')"
flags=()
if [ "$major" -ge 24 ]; then
  :  # JSPI on by default
elif [ "$major" -ge 22 ]; then
  flags+=(--experimental-wasm-jspi)
else
  echo "wasm/nvim: Node $major is too old for this build; use Node >= 22." >&2
fi

# Default args (no user config / no shada), overridable via $NVIM_WASM_DEFAULTS.
# shellcheck disable=SC2206
default_args=(${NVIM_WASM_DEFAULTS--u NONE -i NONE})

# The `[@]+...` idiom expands to nothing (instead of erroring under `set -u`) when
# an array is empty, e.g. no flags on Node 24+ or NVIM_WASM_DEFAULTS="".
exec "$NODE" ${flags[@]+"${flags[@]}"} "$DIR/nvim.js" -- \
  ${default_args[@]+"${default_args[@]}"} "$@"
